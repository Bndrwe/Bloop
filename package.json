{
  "name": "bloop",
  "version": "0.1.0",
  "description": "A cute desktop study companion that tracks your focus and nudges you back on task.",
  "main": "./out/main/index.js",
  "type": "module",
  "author": "Bloop team",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "build": "npm run typecheck && node scripts/bundle-model.mjs --check && electron-vite build && electron-builder --mac --dir",
    "build:mac": "npm run typecheck && node scripts/bundle-model.mjs --check && electron-vite build && electron-builder --mac",
    "build:win": "npm run typecheck && node scripts/bundle-model.mjs --check && electron-vite build && electron-builder --win",
    "build:vite": "electron-vite build",
    "perms": "bash scripts/mac-permissions.sh",
    "model:train": "bash ml/run_mac.sh",
    "model:bundle": "node scripts/bundle-model.mjs",
    "model:publish": "bash ml/publish.sh"
  },
  "build": {
    "appId": "edu.bloop.app",
    "productName": "Bloop",
    "npmRebuild": false,
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/get-windows/**",
      "node_modules/node-llama-cpp/**",
      "node_modules/@node-llama-cpp/**"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg"
      ],
      "identity": "-",
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "Bloop reads the URL of your front browser tab to tell study sites from distracting ones. Nothing leaves your Mac."
      }
    },
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "electron-vite": "^4.0.1",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "animejs": "^4.5.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "electron-store": "^10.1.0",
    "get-windows": "^9.3.0",
    "lucide-react": "^1.68.0",
    "node-ical": "^0.20.1",
    "node-llama-cpp": "3.22.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0"
  }
}
