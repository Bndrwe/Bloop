{
  "name": "bloop",
  "version": "1.0.0",
  "description": "A cute desktop study companion that tracks your focus and nudges you back on task.",
  "main": "./out/main/index.js",
  "type": "module",
  "author": "Bloop team",
  "homepage": "https://github.com/Bndrwe/StudyPet",
  "desktopName": "bloop.desktop",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "install-app": "bash scripts/install.sh",
    "install-app:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install.ps1",
    "uninstall-app": "bash scripts/uninstall.sh",
    "uninstall-app:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall.ps1",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "build": "npm run typecheck && electron-vite build && electron-builder --mac --dir",
    "build:mac": "npm run typecheck && electron-vite build && electron-builder --mac --publish never",
    "build:win": "npm run typecheck && electron-vite build && electron-builder --win --x64 --publish never",
    "build:linux": "npm run typecheck && electron-vite build && electron-builder --linux --x64 --publish never",
    "build:vite": "electron-vite build",
    "perms": "bash scripts/mac-permissions.sh"
  },
  "build": {
    "appId": "io.github.bndrwe.bloop",
    "productName": "Bloop",
    "npmRebuild": false,
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/.env*",
      "!**/*.{pem,p12,pfx,key}"
    ],
    "asarUnpack": [
      "node_modules/get-windows/**"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "Bloop reads the URL of your front browser tab to tell study sites from distracting ones. Nothing leaves your Mac."
      },
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "files": [
        "out/**/*",
        "package.json"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "${productName}-Setup-${version}-win-${arch}.${ext}",
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "shortcutName": "Bloop"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "executableName": "bloop",
      "category": "Education;Utility",
      "maintainer": "Bloop team <bloop@users.noreply.github.com>",
      "icon": "build/icons",
      "synopsis": "Your little study pet",
      "description": "A cute desktop study companion that tracks your focus and nudges you back on task.",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Keywords": "study;focus;pomodoro;timer;",
          "StartupNotify": "false"
        }
      },
      "files": [
        "out/**/*",
        "package.json"
      ]
    },
    "appImage": {
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "${name}_${version}_${arch}.${ext}",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "x11-utils"
      ],
      "recommends": [
        "libayatana-appindicator3-1 | libappindicator3-1",
        "gnome-shell-extension-appindicator"
      ]
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": true
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "electron-vite": "^4.0.1",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "animejs": "^4.5.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "electron-store": "^10.1.0",
    "get-windows": "^9.3.0",
    "lucide-react": "^1.68.0",
    "node-ical": "^0.20.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0"
  }
}
